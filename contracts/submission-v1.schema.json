{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workcadence.local/contracts/transfer/submission-v1.schema.json",
  "title": "WorkCadenceTransfer submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "deviceId", "submissionId", "createdAt", "targetDate", "contentDigest", "memo", "photos"],
  "properties": {
    "version": { "const": 1 },
    "type": { "const": "transfer_submission" },
    "deviceId": { "$ref": "#/$defs/uuidV4" },
    "submissionId": { "$ref": "#/$defs/uuidV4" },
    "createdAt": { "$ref": "#/$defs/utcMilliseconds" },
    "targetDate": { "$ref": "#/$defs/localDate" },
    "contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "memo": {
      "type": "string",
      "maxLength": 8192,
      "x-maxUtf8Bytes": 8192,
      "x-normalization": "CRLF_AND_CR_TO_LF_THEN_NFC"
    },
    "photos": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "x-uniqueBy": "photoId",
      "x-totalBytesMaximum": 26214400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["photoId", "mime", "bytes", "sha256"],
        "properties": {
          "photoId": { "$ref": "#/$defs/uuidV4" },
          "mime": { "const": "image/jpeg" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 5242880 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "memo": { "type": "string", "x-nonBlankAfterNormalization": true }
          }
        },
        {
          "properties": {
            "photos": { "minItems": 1 }
          }
        }
      ]
    }
  ],
  "$defs": {
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcMilliseconds": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "localDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
